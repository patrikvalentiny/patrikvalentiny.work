---
import "../../assets/app.css";
import BrandIdentityBoard from "../../components/BrandIdentityBoard";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#121212" />

        <title>Brand Identity Board | patrikvalentiny.work</title>
        <meta
            name="description"
            content="A brand identity board for Patrik Valentiny, showing the color system, typography stack, and visual principles used across the identity."
        />
        <meta
            name="keywords"
            content="brand identity, visual system, typography, color palette, design system, Patrik Valentiny"
        />
        <meta name="author" content="Patrik Valentiny" />
        <meta name="robots" content="index, follow" />
        <link
            rel="canonical"
            href="https://patrikvalentiny.work/brand-identity"
        />

        <meta property="og:type" content="website" />
        <meta
            property="og:url"
            content="https://patrikvalentiny.work/brand-identity"
        />
        <meta
            property="og:title"
            content="Brand Identity Board | patrikvalentiny.work"
        />
        <meta
            property="og:description"
            content="A brand identity board for Patrik Valentiny, showing the color system, typography stack, and visual principles used across the identity."
        />
        <meta
            property="og:image"
            content="https://patrikvalentiny.work/og-image.jpg"
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:site_name" content="patrikvalentiny.work" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:url"
            content="https://patrikvalentiny.work/brand-identity"
        />
        <meta name="twitter:title" content="Brand Identity Board" />
        <meta
            name="twitter:description"
            content="A brand identity board for Patrik Valentiny, showing the color system, typography stack, and visual principles used across the identity."
        />
        <meta
            name="twitter:image"
            content="https://patrikvalentiny.work/og-image.jpg"
        />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <meta name="generator" content={Astro.generator} />

        {
            import.meta.env.PROD && (
                <script
                    defer
                    src="https://cloud.umami.is/script.js"
                    data-website-id="21bd8d9b-2cc0-4665-9503-426b16821f4b"
                />
            )
        }
    </head>
    <body class="min-h-screen bg-base-100 text-base-content">
        <BrandIdentityBoard />
    </body>
</html>
