---
import "../assets/app.css";

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	image?: string;
	theme?: string;
	icon?: string;
	iconIco?: string;
	header?: boolean;
}

const {
	title = "Patrik Valentiny | Developer and creative technologist based in Copenhagen, Denmark",
	description = "Portfolio and works of Patrik Valentiny",
	canonical = "https://patrikvalentiny.work",
	image = "https://patrikvalentiny.work/og-image.jpg",
	theme,
	icon = "/favicon.png",
	iconIco = "/favicon.ico",
	header = false,
} = Astro.props as Props;
---

<!doctype html>
<html lang="en" {...theme ? { "data-theme": theme } : {}}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#000000" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="developer, videographer, photographer, creative technologist, creative lead, copenhagen, denmark, video production, portfolio"
		/>
		<meta name="author" content="Patrik Valentiny" />
		<meta
			name="copyright"
			content="© 2026 Patrik Valentiny. All rights reserved."
		/>
		<meta
			name="robots"
			content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
		/>
		<meta name="language" content="English" />
		<meta name="revisit-after" content="7 days" />
		<link rel="canonical" href={canonical} />

		<meta name="geo.placename" content="Copenhagen" />
		<meta name="geo.region" content="DK" />
		<meta name="geo.position" content="55.6761;12.5683" />
		<meta name="ICBM" content="55.6761, 12.5683" />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:locale:alternate" content="da_DK" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<link
			rel="icon"
			type={icon.endsWith(".svg") ? "image/svg+xml" : "image/png"}
			href={icon}
		/>
		<link rel="icon" href={iconIco} />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Patrik Valentiny",
				"url": "https://patrikvalentiny.work",
				"sameAs": [
					"https://www.linkedin.com/in/patrik-valentiny/",
					"https://github.com/patrikvalentiny",
					"https://www.instagram.com/patrikvalentiny/"
				],
				"jobTitle": "Digitalization Engineer & Full-Stack Developer",
				"worksFor": {
					"@type": "Organization",
					"name": "Siemens Gamesa"
				},
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Vejle",
					"addressCountry": "DK"
				},
				"knowsAbout": [
					"Software Engineering",
					"Digitalization",
					"Full-Stack Web Development",
					"C# (.NET)",
					"React",
					"Angular",
					"Python",
					"SQL Server",
					"PostgreSQL",
					"Power Platform",
					"Mendix",
					"Machine Learning",
					"AI Agents",
					"RAG",
					"AutoGen",
					"Astro",
					"TypeScript",
					"DevOps",
					"Docker",
					"Cybersecurity"
				],
				"mainEntityOfPage": {
					"@type": "ProfilePage",
					"@id": "https://patrikvalentiny.work/cv"
				},
				"image": "https://patrikvalentiny.work/profile-image.jpg"
			}
		</script>

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "Patrik Valentiny Portfolio",
				"url": "https://patrikvalentiny.work",
				"description": "Portfolio of Patrik Valentiny - Developer and creative technologist based in Copenhagen, Denmark",
				"potentialAction": {
					"@type": "SearchAction",
					"target": {
						"@type": "EntryPoint",
						"urlTemplate": "https://patrikvalentiny.work/search?q={search_term_string}"
					},
					"query-input": "required name=search_term_string"
				}
			}
		</script>

		<meta name="generator" content={Astro.generator} />

		{
			import.meta.env.PROD && (
				<script
					defer
					src="https://cloud.umami.is/script.js"
					data-website-id="21bd8d9b-2cc0-4665-9503-426b16821f4b"
				/>
			)
		}
	</head>
	<body class="min-h-screen bg-base-200 text-base-content">
		{
			header && (
				<header class="flex items-center justify-center gap-4 top-0 fixed w-full max-w-full z-50 bg-transparent">
					<div class="flex items-center justify-between backdrop-blur-md bg-base-100/70 p-3 sm:p-4 w-full max-w-4xl rounded-xl border border-base-content/10 m-2 shadow-lg">
						<a
							href="/"
							class="group flex items-center gap-3 transition-opacity hover:opacity-90"
						>
							<span class="badge badge-outline border-accent/70 bg-transparent px-3 py-2 text-xs sm:text-sm tracking-wide uppercase text-accent font-semibold group-hover:bg-accent/10 transition-colors">
								Patrik Valentiny
							</span>
							<span class="hidden sm:inline text-xs text-base-content/70 font-mono">
								Performance Architect
							</span>
						</a>
						<div class="flex items-center gap-2">
							<a
								href="/"
								class="btn btn-ghost btn-sm h-8 px-3 text-xs uppercase tracking-wider font-mono"
							>
								Home
							</a>
						</div>
					</div>
				</header>
			)
		}
		<slot />
	</body>
</html>
